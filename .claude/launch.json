{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tremor",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["scripts/dev.sh"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "tremor-fresh",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["scripts/dev.sh", "--fresh"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "tremor-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web", "--", "--port", "3000"],
      "port": 3000,
      "autoPort": false
    }
  ]
}
