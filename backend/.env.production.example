# Production API configuration (Fly.io). Set via fly.toml [env] or `fly secrets set`.
#
# This API is read-only by design: it holds no keys and refuses to start if given one
# (see src/config.rs — CHECKPOINT_WORKER / CHECKPOINT_PRIVATE_KEY are a deliberate startup error).
# Nothing in this file is secret, and nothing secret should ever be added to it.

RPC_URL=https://sepolia.base.org

# Must be the schema-3 manifest, copied into the image. The backend validates the schema version and
# refuses to start against one it does not understand rather than mis-decoding it.
DEPLOYMENT_JSON=/app/deployments/84532.json

# MUST live on the mounted volume. The default (sqlite://tremor.db) is relative and would land on
# ephemeral container disk, so every deploy would re-index from block 46685189 and serve incomplete
# data until it caught up.
DATABASE_URL=sqlite:///data/tremor_84532.db

PORT=8080

# MUST be 0.0.0.0. The default 127.0.0.1 means the container listens only to itself and every health
# check fails.
BIND_ADDRESS=0.0.0.0

# The exact public origin of the frontend — no trailing slash, no wildcard. The default is
# http://localhost:3000, which blocks every call from a deployed frontend.
# build_cors() accepts a comma-separated list and treats "*" as Any; do not use "*".
# Vercel preview deployments get per-deployment URLs that will not match, so demo from the production
# origin only, or list the additional origins explicitly.
CORS_ORIGIN=<https://your-frontend-origin>

POLL_MS=3000
