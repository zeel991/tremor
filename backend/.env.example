# Tremor backend configuration (all optional; defaults shown)
RPC_URL=http://127.0.0.1:8545
DEPLOYMENT_JSON=../contracts/deployments/31337.json
DATABASE_URL=sqlite://tremor.db
PORT=8787
BIND_ADDRESS=127.0.0.1 # set deliberately; do not expose this unauthenticated API accidentally
POLL_MS=3000
CORS_ORIGIN=http://localhost:3000
RUST_LOG=tremor_api=info,tower_http=info

# The manifest must be schema v2. A v1 manifest (with a `factory` key and no vault, engine or
# accumulator) is rejected at startup rather than partially understood.
#
# There is no checkpoint keeper and no signing key. Checkpointing and finalization are permissionless,
# and the web app submits them from the user's own wallet. Setting CHECKPOINT_WORKER or
# CHECKPOINT_PRIVATE_KEY is a startup error, so nobody is left believing a keeper is running.
#
# A schema change needs an explicit `tremor-api --reset-db`; startup never destroys an indexed
# history on its own.
