# Public Base Sepolia deployment of Tremor (manifest schema 3: v2 series + v3 portfolio groups).
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Run a backend configured with contracts/deployments/84532.json.
NEXT_PUBLIC_API_URL=http://localhost:8789

# The Graph: DELIBERATELY EMPTY.
#
# The previously published Studio endpoint (.../tremor/v2) is live and fully synced, but it indexes an
# ABANDONED deployment — its only vault is 0x5276bcc6…, not the current 0x9C9341d0… — and its schema has
# no portfolio entities at all. Pointing the app at it would surface stale, unrelated data as if it were
# Tremor's indexing layer.
#
# With this unset the app falls back to the Rust API and to direct chain reads, which are current. Set it
# only after a v3 version is published AND verified to return portfolioGroups with hasIndexingErrors false.
#
# Note also that The Graph does NOT index portfolio checkpoints: the Checkpointed handler is bound to the
# v2 series accumulator. Portfolio checkpoints are served by the Rust backend only.
NEXT_PUBLIC_TREMOR_SUBGRAPH_URL=
