# Production frontend configuration (Vercel → Project → Settings → Environment Variables → Production).
#
# Copy these names and fill the two <…> placeholders with the URLs your own hosting produces. Nothing here
# is secret: every NEXT_PUBLIC_* value is inlined into the client bundle at build time and is public by
# definition. Never put a credential, deploy key, or non-disposable RPC key in this file or in Vercel's
# environment under a NEXT_PUBLIC_ name.

NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# The public origin of the Rust API (Fly.io app URL). No trailing slash.
# The API's own CORS_ORIGIN must be set to this frontend's origin, or every browser call is blocked.
NEXT_PUBLIC_API_URL=<https://your-api-host>

# The Graph: leave EMPTY until a v3 subgraph is published and verified.
# The previously published .../tremor/v2 endpoint indexes an abandoned deployment and must not be used.
# Empty means the app reads from the Rust API and directly from chain — both current — and makes no
# Graph-sourced claim anywhere in the UI.
NEXT_PUBLIC_TREMOR_SUBGRAPH_URL=
